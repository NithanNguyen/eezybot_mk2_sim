    <!-- Servo kep SG90 (truc = banh rang trai, ti so 1): 0 = dong, 1.571 rad = mo het;
         kep but D10: 0.0748 rad (4.29 do) -->
    <position name="servo_gripper" joint="gripper" gear="1" kp="2.02277" forcelimited="true" forcerange="-0.17652 0.17652" ctrllimited="true" ctrlrange="0 1.5708"/>
  </actuator>
